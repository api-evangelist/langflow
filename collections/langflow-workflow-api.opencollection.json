{
  "opencollection": "1.0.0",
  "info": {
    "name": "Langflow Base Workflow API",
    "version": "1.9.0"
  },
  "items": [
    {
      "info": {
        "name": "Workflow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Workflow Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/workflows",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "query",
                "description": "Job ID to query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "query"
            }
          },
          "docs": "Get status of workflow job by job ID"
        },
        {
          "info": {
            "name": "Execute Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "query"
            }
          },
          "docs": "Execute a workflow with support for sync, stream, and background modes"
        },
        {
          "info": {
            "name": "Stop Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/workflows/stop",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "query"
            }
          },
          "docs": "Stop a running workflow execution"
        }
      ]
    }
  ],
  "bundled": true
}